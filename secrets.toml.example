# Copy this file to .streamlit/secrets.toml for local development and
# fill in real values. On Streamlit Community Cloud, do NOT upload this
# file — instead paste these same key/value pairs into:
#   Your app -> Settings -> Secrets
# in the Streamlit Cloud dashboard.
#
# NEVER commit a filled-in secrets.toml to git.

# --- Fabric / Azure service principal ---
FABRIC_CLIENT_ID = "your-app-registration-client-id"
FABRIC_CLIENT_SECRET = "your-app-registration-client-secret"
FABRIC_TENANT_ID = "your-azure-tenant-id"

# --- OneLake / Fabric workspace + lakehouse IDs ---
FABRIC_WORKSPACE_ID = "your-fabric-workspace-id"
FABRIC_LAKEHOUSE_ID_SILVER = "your-silver-lakehouse-id"
FABRIC_LAKEHOUSE_ID_BRONZE = "your-bronze-lakehouse-id"

# --- Branding (optional - shown in the header) ---
APP_TITLE = "Man Mandir Silks and Saris"
APP_SUBTITLE = "PRODUCT GALLERY"
APP_ICON = "🧵"
